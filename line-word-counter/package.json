{
    "name": "line-word-counter",
    "displayName": "Line Word Counter",
    "description": "Shows the number of lines and words in the current file.",
    "version": "0.0.1",
    "publisher": "freelanceralfonso",
    "engines": {
        "vscode": "^1.70.0"
    },
    "activationEvents": [
        "onCommand:extension.showCounts"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.showCounts",
                "title": "Show Line and Word Counts"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./"
    },
    "devDependencies": {
        "typescript": "^4.0.0",
        "vscode": "^1.1.37",
        "@types/node": "^14.14.37"
    }
}
